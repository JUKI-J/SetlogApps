{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SetlogApps registry",
  "type": "object",
  "required": ["apps"],
  "properties": {
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "status", "name", "appStoreId", "storeKind", "platforms", "heroOrientation", "minOS", "category", "campaignLink", "locales", "primaryLocale", "icon", "keywords", "forbiddenClaims", "updated"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "status": {"enum": ["live", "hidden", "retired"]},
          "name": {"type": "string", "minLength": 1},
          "storeNames": {"type": "object"},
          "appStoreId": {"type": "string", "pattern": "^[0-9]{6,12}$"},
          "storeKind": {"enum": ["mac", "ios"]},
          "platforms": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "heroOrientation": {"description": "hero screenshot layout: landscape (Mac, 1 shot) | portrait (phone, 2-3 shots side by side)", "enum": ["landscape", "portrait"]},
          "minOS": {"type": "string"},
          "minAndroid": {"description": "optional, Play-badge apps only, e.g. 'Android 10'; omitted from the page when absent", "type": "string"},
          "category": {"enum": ["Utilities", "Photo & Video", "Music", "Health & Fitness", "Sports", "Productivity", "Food & Drink"]},
          "campaignLink": {"description": "null until pasted from the ASC campaign link generator (ct=web-<slug>-<locale>). When set: an object {locale: url}.", "type": ["object", "null"]},
          "playUrl": {"description": "Google Play listing; set when the app also ships on Android (platforms includes Android)", "type": ["string", "null"], "pattern": "^https://play\\.google\\.com/store/apps/details\\?id=[A-Za-z0-9_.]+$"},
          "locales": {"type": "array", "items": {"enum": ["en", "ko", "ja", "zh-hans", "zh-hant", "de", "fr", "es", "it", "pt-br", "ru", "tr"]}, "minItems": 1},
          "primaryLocale": {"enum": ["en", "ko", "ja", "zh-hans", "zh-hant", "de", "fr", "es", "it", "pt-br", "ru", "tr"]},
          "icon": {"type": "string", "pattern": "^/images/"},
          "site": {"description": "support/about/privacy regions: supportLabel, supportHref, privacyName, privacyLangs[en|kr|ja], about{en,ko}{name,text}", "type": "object", "required": ["supportLabel", "supportHref", "privacyName", "privacyLangs", "about"]},
          "guides": {"type": "array", "items": {"type": "object", "required": ["href", "title"], "properties": {"href": {"type": "string", "pattern": "^/"}, "title": {"type": "object"}}}},
          "keywords": {"type": "object"},
          "forbiddenClaims": {"type": "array", "items": {"type": "string"}},
          "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    }
  }
}
